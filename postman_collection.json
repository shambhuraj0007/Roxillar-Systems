{
  "info": {
    "name": "Store Rating Platform API",
    "description": "Complete Postman collection for Store Rating Platform endpoints across all roles (Admin, Store Owner, Normal User).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@12345678\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "2. Login as Store Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"Owner@12345678\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "3. Login as Normal User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"User@12345678\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "4. Signup Normal User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jonathan Edward Customer\",\n  \"email\": \"jonathan@example.com\",\n  \"password\": \"SecurePass@123\",\n  \"address\": \"742 Evergreen Terrace Springfield\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "5. Update Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"User@12345678\",\n  \"newPassword\": \"NewPassword@99\"\n}"
            },
            "url": "{{baseUrl}}/auth/update-password"
          }
        }
      ]
    },
    {
      "name": "Admin Endpoints",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "Get Users (with Filters & Sorting)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?role=&name=&sortBy=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "role", "value": "" },
                { "key": "name", "value": "" },
                { "key": "sortBy", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Store Owners List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/admin/owners"
          }
        },
        {
          "name": "Get Stores (with Filters & Sorting)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/stores?name=&sortBy=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stores"],
              "query": [
                { "key": "name", "value": "" },
                { "key": "sortBy", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Create New User (Admin/User/Owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Jessica Parker Store\",\n  \"email\": \"sarah.owner@example.com\",\n  \"password\": \"OwnerPass@1234\",\n  \"address\": \"890 Fifth Avenue Downtown\",\n  \"role\": \"owner\"\n}"
            },
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Create New Store",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fresh Produce Farmers Market\",\n  \"email\": \"contact@farmersmarket.com\",\n  \"address\": \"320 Organic Way Boulevard\",\n  \"owner_id\": null\n}"
            },
            "url": "{{baseUrl}}/admin/stores"
          }
        }
      ]
    },
    {
      "name": "User & Store Ratings",
      "item": [
        {
          "name": "Browse & Search Stores",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores?name=&address=&sortBy=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["stores"],
              "query": [
                { "key": "name", "value": "" },
                { "key": "address", "value": "" },
                { "key": "sortBy", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Submit or Modify Store Rating (1-5)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5\n}"
            },
            "url": "{{baseUrl}}/stores/1/rate"
          }
        }
      ]
    },
    {
      "name": "Store Owner Endpoints",
      "item": [
        {
          "name": "Get Owner Dashboard (Avg Rating & Raters)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/owner/dashboard"
          }
        }
      ]
    }
  ]
}
