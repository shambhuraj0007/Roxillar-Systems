PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Option 1: Standard Aiven parameters
DB_HOST=your-mysql-service.aivencloud.com
DB_PORT=11492
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
DB_SSL=true

# Option 2: Or paste the full Aiven Service URI directly
# DATABASE_URL=mysql://avnadmin:password@host:port/defaultdb?ssl-mode=REQUIRED
